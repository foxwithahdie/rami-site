---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { groups } from '../data/index-entries.js';
import Facet from '../components/Facet.astro';
import { themeOf } from '../data/facets.js';
import { themeForHref, isLive } from '../data/routes.js';
const filters = [{ slug:'all', label:'ALL' }, ...groups.map(g => ({ slug:g.slug, label:g.facet }))];
---
<Base title="Work — rami" theme="home" current="WORK"
      description="Everything Ramzey Burdette has built, including the parts that never got their own page.">
  <Hero facet="INDEX" year="2022 — now" title="Work"
        lead="Everything, including the parts that never got their own page."
        tags="nine pages  ·  six more that live on the CV" />

  <!-- The filter is radio inputs plus the general sibling combinator. No
       JavaScript, and no :has(), which is a 2023 selector. The inputs sit as
       siblings of the list so `#f-x:checked ~ .groups` can reach it. -->
  <section class="filter wrap">
    <!-- The inputs are DIRECT SIBLINGS of .groups. That is not a style choice:
         the general sibling combinator only reaches siblings, so wrapping them
         in a fieldset silently breaks the whole filter while still letting the
         chips highlight. The radios are still one group because they share a
         name; the visible chips are labels pointing back at them. -->
    {filters.map((f, i) => (
      <input class="vh f-input" type="radio" name="facet" id={`f-${f.slug}`} value={f.slug} checked={i === 0} />
    ))}

    <div class="fs" role="radiogroup" aria-label="Filter by facet">
      {filters.map((f) => (
        <label class="chip t-label" for={`f-${f.slug}`}>{f.label}</label>
      ))}
    </div>

    <div class="groups">
      {groups.map((g) => (
        <section class={`group is-${g.slug}`}>
          <h2 class="t-label group-head">{g.facet}</h2>
          <ul class="rows">
            {g.items.map((it) => (
              <li class="row-item">
                {it.href && isLive(it.href) && !it.soon ? (
                  <a class="entry" href={it.href}>
                    <span class="t-mono e-year">{it.year}</span>
                    <span class="e-body">
                      <span class="t-card e-title">{it.title}</span>
                      <span class="t-mono e-role">{it.role}</span>
                      <span class="t-item e-blurb">{it.blurb}</span>
                    </span>
                    <span class="t-label e-open">OPEN  →</span>
                  </a>
                ) : (
                  <div class="entry is-cv">
                    <span class="t-mono e-year">{it.year}</span>
                    <span class="e-body">
                      <span class="t-card e-title">{it.title}</span>
                      <span class="t-mono e-role">{it.role}</span>
                      <span class="t-item e-blurb">{it.blurb}</span>
                    </span>
                    <span class="t-label e-open">{it.soon ? 'COMING SOON!' : 'ON THE CV'}</span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .vh { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  .filter { padding-top:20px; padding-bottom:60px; }
  .chip {
    display:inline-block; margin:0 8px 8px 0; padding:9px 13px;
    border:3px solid var(--ink); cursor:pointer;
  }
  /* :checked and ~ are both ancient. This is the whole filter. */
  .fs { border:0; margin:0; padding:0; display:flex; flex-wrap:wrap; }
  /* One rule per facet: the checked input styles its own label inside .fs. */
  #f-all:checked      ~ .fs label[for="f-all"],
  #f-firmware:checked ~ .fs label[for="f-firmware"],
  #f-digital:checked  ~ .fs label[for="f-digital"],
  #f-shop:checked     ~ .fs label[for="f-shop"],
  #f-software:checked ~ .fs label[for="f-software"],
  #f-teaching:checked ~ .fs label[for="f-teaching"],
  #f-games:checked    ~ .fs label[for="f-games"] { background:var(--ink); color:var(--paper); }
  .fs { margin-bottom:30px; }

  .group + .group { margin-top:38px; }
  .group-head { color:var(--accent); margin:0 0 14px; }
  .rows { list-style:none; margin:0; padding:0; }
  .row-item + .row-item { margin-top:16px; }

  /* Figma: horizontal, centred, year left, body, OPEN right.
     Border only, no shadow. Page paper, not a per-row world. */
  .entry {
    display:block; padding:20px; text-decoration:none; color:var(--ink);
    background:var(--paper);
    border:var(--outline) solid var(--ink);
  }
  .e-year  { display:block; opacity:.8; }
  .e-body  { display:block; margin-top:10px; }
  .e-title { display:block; }
  .e-role  { display:block; margin-top:6px; opacity:.8; }
  .e-blurb { display:block; margin-top:8px; }
  .e-open  { display:block; margin-top:14px; color:var(--accent); }
  .is-cv { border-style:dashed; opacity:.85; }
  .is-cv .e-open { color:var(--accent); opacity:1; }

  /* Filtering. Hidden groups are display:none, which cannot be transitioned,
     but an ANIMATION does run when an element goes from display:none to
     display:block. So the group that appears fades and rises into place while
     the ones that leave simply go. No script, and nothing is ever mid-fade
     when you land on the page. */
  /* A CSS animation only restarts when the element is re-rendered or when a
     DIFFERENT animation is applied. Going ALL -> TEACHING leaves the teaching
     group displayed the whole time, so a single shared keyframe name would
     never re-run. Giving the two states different names forces the restart on
     every filter change. */
  @keyframes filter-in-a { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
  @keyframes filter-in-b { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }

  #f-all:checked ~ .groups .group { animation:filter-in-a 300ms var(--ease) both; }
  #f-firmware:checked ~ .groups .is-firmware,
  #f-digital:checked  ~ .groups .is-digital,
  #f-shop:checked     ~ .groups .is-shop,
  #f-software:checked ~ .groups .is-software,
  #f-teaching:checked ~ .groups .is-teaching,
  #f-games:checked    ~ .groups .is-games { animation:filter-in-b 300ms var(--ease) both; }
  /* The rows inside stagger slightly, so a group arrives rather than blinks. */
  #f-all:checked ~ .groups .row-item { animation:filter-in-a 340ms var(--ease) both; }
  #f-firmware:checked ~ .groups .is-firmware .row-item,
  #f-digital:checked  ~ .groups .is-digital  .row-item,
  #f-shop:checked     ~ .groups .is-shop     .row-item,
  #f-software:checked ~ .groups .is-software .row-item,
  #f-teaching:checked ~ .groups .is-teaching .row-item,
  #f-games:checked    ~ .groups .is-games    .row-item { animation:filter-in-b 340ms var(--ease) both; }
  .row-item:nth-child(1) { animation-delay:50ms; }
  .row-item:nth-child(2) { animation-delay:110ms; }
  .row-item:nth-child(3) { animation-delay:170ms; }
  .row-item:nth-child(4) { animation-delay:230ms; }
  @media (prefers-reduced-motion: reduce) {
    .group, .row-item { animation:none; }
  }

  /* Show everything for ALL; otherwise show only the chosen group. */
  #f-all:checked      ~ .groups .group { display:block; }
  #f-firmware:checked ~ .groups .group,
  #f-digital:checked  ~ .groups .group,
  #f-shop:checked     ~ .groups .group,
  #f-software:checked ~ .groups .group,
  #f-teaching:checked ~ .groups .group,
  #f-games:checked    ~ .groups .group { display:none; }
  #f-firmware:checked ~ .groups .is-firmware,
  #f-digital:checked  ~ .groups .is-digital,
  #f-shop:checked     ~ .groups .is-shop,
  #f-software:checked ~ .groups .is-software,
  #f-teaching:checked ~ .groups .is-teaching,
  #f-games:checked    ~ .groups .is-games { display:block; }

  @media (min-width:64em) {
    .filter { padding-top:30px; padding-bottom:110px; }
    .chip { padding:12px 20px; margin:0 12px 12px 0; }
    .group + .group { margin-top:60px; }
    .rows > .row-item + .row-item { margin-top:16px; }

    .entry { display:flex; align-items:center; padding:24px 26px 26px; }
    .e-year { flex:0 0 170px; margin-right:26px; }
    .e-body { flex:1 1 auto; margin-top:0; margin-right:26px; }
    .e-open { flex:0 0 auto; margin-top:0; white-space:nowrap; }
  }
</style>
