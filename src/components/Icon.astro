---
// Brand marks, inlined rather than <img src>. An SVG loaded through <img> is
// a separate document and inherits nothing from the page, so a file with a
// hardcoded fill can only ever be that one colour. Inlining puts the fill
// under our control. Two fewer requests as a side effect.
//
// `color` defaults to currentColor, which is right for an ordinary UI icon.
// IT IS NOT RIGHT FOR A BRAND MARK. Both LinkedIn and GitHub only license
// specific colour variations of their logo, and LinkedIn says so outright:
// "You may only use the approved color variations provided for download."
// --chrome-fg is #FAF7F2, a warm off-white, so letting these inherit would
// tint a trademark. The footer passes #FFFFFF explicitly instead. Keep it
// that way, and pass an approved value at any new call site.
//
// LinkedIn is deliberately NOT here. Their [in] bug ships as PNG only and may
// not be redrawn, so the footer uses their exact file through <img> instead.
// Do not add an inline LinkedIn path back to this component.
//
// No class attributes inside the path, so nothing collides on a page.
const { name, size = 22, label, color = 'currentColor' } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---
{name === 'github' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 499.368" width={size} height={size} {...a11y}
       fill-rule="evenodd" clip-rule="evenodd" class="icon">
    <path fill={color} fill-rule="nonzero" d="M256.003 0C114.555 0 0 114.555 0 256.003c0 113.286 73.28 208.961 175.038 242.865 12.796 2.247 17.586-5.433 17.586-12.153 0-6.077-.309-26.225-.309-47.686-64.313 11.844-80.941-15.674-86.058-30.055-2.896-7.37-15.359-30.1-26.269-36.177-8.948-4.808-21.752-16.652-.31-16.961 20.168-.309 34.574 18.564 39.382 26.244 23.038 38.732 59.839 27.828 74.555 21.101 2.227-16.627 8.947-27.828 16.318-34.239-56.968-6.386-116.467-28.471-116.467-126.399 0-27.827 9.907-50.866 26.225-68.787-2.562-6.41-11.51-32.655 2.562-67.853 0 0 21.436-6.72 70.409 26.244 20.483-5.767 42.227-8.638 63.998-8.638 21.751 0 43.52 2.896 63.997 8.638 48.973-33.279 70.39-26.244 70.39-26.244 14.09 35.192 5.117 61.443 2.562 67.853 16.318 17.921 26.244 40.625 26.244 68.787 0 98.237-59.84 119.988-116.801 126.399 9.282 8.014 17.277 23.373 17.277 47.371 0 34.238-.309 61.751-.309 70.389 0 6.721 4.808 14.735 17.586 12.179C438.739 464.964 512 368.955 512 256.003 512 114.555 397.445 0 256.003 0z"/>
  </svg>
)}
<style>
  .icon { display:block; }
</style>
